<div class="collapse-group" data-group="2">
{% for fragment in fragments362 %}
  <h3
    lang="arc"
    dir="rtl"
    class="collapse-header rtl"
    role="button"
    tabindex="0"
    data-bs-toggle="collapse"
    data-bs-target="#{{ fragment.id }}"
    aria-expanded="false"
    aria-controls="{{ fragment.id }}"
    id="heading-{{ fragment.id }}"
  >
    {{ fragment.text | safe }}
    <i class="fa-solid fa-chevron-up chevron" aria-hidden="true"></i>
  </h3>
  <div
    id="{{ fragment.id }}"
    class="collapse show interlinear-gloss"
    aria-labelledby="heading-{{ fragment.id }}"
  >
    <table class="table table-borderless mt-2 mb-4">
      {% include 'nunjucks/fictional-works/_include/zohar/' +  fragment.id + '-gloss.html' %}
    </table>
    {% if fragment.id != 'derabeyey' %}
      <ul class="twinkle">
        {% include 'nunjucks/fictional-works/_include/zohar/' +  fragment.id + '-vocab.html' %}
      </ul>
    {% endif %}
  </div>
{% endfor %}
</div>

</section>
{% endblock %}

{% block script %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const paragraphs = document.querySelectorAll('#translation p');
  paragraphs.forEach(p => {
    p.innerHTML = p.innerHTML.replace(/\n/g, '');
  });

  const expandButtons = document.querySelectorAll('[id^="expand-all-"]');

  expandButtons.forEach(button => {
    const groupId = button.id.split('-').pop();
    const group = document.querySelector(`.collapse-group[data-group="${groupId}"]`);
    const collapses = group ? group.querySelectorAll('.collapse') : [];

    const label = button.querySelector('.expand-label');

    const areAllOpen = () => {
      return Array.from(collapses).every(el => el.classList.contains('show'));
    };

    const updateLabel = () => {
      const allOpen = areAllOpen();
      if (allOpen) {
        button.classList.remove('collapsed');
        label.textContent = 'Collapse All';
      } else {
        button.classList.add('collapsed');
        label.textContent = 'Expand All';
      }
    };

    const toggleAll = () => {
      const allOpen = areAllOpen();
      const shouldShow = !allOpen;

      collapses.forEach(el => {
        const instance = new window.BSN.Collapse(el);
        if (shouldShow) {
          instance.show();
        } else {
          instance.hide();
        }

        const header = document.querySelector(`[aria-controls="${el.id}"]`);
        if (header) {
          if (shouldShow) {
            header.classList.remove('collapsed');
          } else {
            header.classList.add('collapsed');
          }
        }
      });

      updateLabel();
    };

    button.setAttribute('tabindex', '0');
    button.setAttribute('role', 'button');
    button.addEventListener('click', toggleAll);
    button.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleAll();
      }
    });

    collapses.forEach(collapse => {
      collapse.addEventListener('shown.bs.collapse', updateLabel);
      collapse.addEventListener('hidden.bs.collapse', updateLabel);
    });
  });

  document.querySelectorAll('.collapse-header[data-bs-toggle="collapse"]').forEach(header => {
    const targetId = header.getAttribute('data-bs-target')?.replace('#', '');
    const target = document.getElementById(targetId);

    if (target) {
      target.addEventListener('show.bs.collapse', () => {
        header.classList.remove('collapsed');
      });

      target.addEventListener('hide.bs.collapse', () => {
        header.classList.add('collapsed');
      });

      if (target.classList.contains('show')) {
        header.classList.remove('collapsed');
      } else {
        header.classList.add('collapsed');
      }
    }
  });
});
</script>
{% endblock %}
